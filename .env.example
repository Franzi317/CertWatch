# CertWatch configuration. Copy to .env and adjust. NEVER commit real secrets.

# --- Database ---
# Local dev default is SQLite (no setup). Docker Compose overrides this with Postgres.
# CERTWATCH_DATABASE_URL=sqlite:///./certwatch.db
POSTGRES_USER=certwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=certwatch

# --- API auth (optional) ---
# When set, all /api routes require: Authorization: Bearer <key>. Unset = open (local).
CERTWATCH_API_KEY=

# --- CORS (React dev server origins) ---
CERTWATCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Scan safety guardrails ---
CERTWATCH_MAX_CIDR_HOSTS=4096
CERTWATCH_DEFAULT_TIMEOUT=5.0
CERTWATCH_DEFAULT_CONCURRENCY=50
CERTWATCH_DEFAULT_PORTS=443

# --- Scheduler ---
CERTWATCH_ENABLE_SCHEDULER=true

# Path to the built frontend (set automatically in the Docker image).
# CERTWATCH_STATIC_DIR=/app/static

# NOTE: SMTP passwords and webhook URLs are configured per notification channel
# in the UI/API and stored in the database; they are never returned by the API.

# Certificate Transparency monitoring (Phase 2.5). Blank disables the feature.
CERTWATCH_CT_SOURCE_URL=https://crt.sh
CERTWATCH_CT_CHECK_FREQUENCY_HOURS=24
CERTWATCH_CT_FINDING_SEVERITY=warning
